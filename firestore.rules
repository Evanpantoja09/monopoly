rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    match /rooms/{roomCode} {
      function isAdmin() {
        return signedIn() && resource.data.adminUid == request.auth.uid;
      }

      function validPlayerJoin() {
        return signedIn()
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'waiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerUids'])
          && request.resource.data.playerUids.size() == resource.data.playerUids.size() + 1
          && request.resource.data.playerUids.size() <= resource.data.maxPlayers
          && !resource.data.playerUids.hasAny([request.auth.uid])
          && request.resource.data.playerUids.hasAny([request.auth.uid])
          && request.resource.data.playerUids.hasAll(resource.data.playerUids)
          && getAfter(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid)).data.uid == request.auth.uid;
      }

      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.playerUids.size() == 0
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers in [2, 3, 4]
        && request.resource.data.gameState == null;

      allow get: if signedIn();
      allow list: if false;
      allow update: if isAdmin() || validPlayerJoin();
      allow delete: if isAdmin();

      match /players/{playerUid} {
        function parentRoom() {
          return get(roomPath(roomCode)).data;
        }
        function isRoomAdmin() {
          return signedIn() && parentRoom().adminUid == request.auth.uid;
        }

        allow get: if signedIn()
          && (request.auth.uid == playerUid || isRoomAdmin() || parentRoom().status == 'waiting');
        allow list: if signedIn()
          && (isRoomAdmin() || parentRoom().status == 'waiting'
            || parentRoom().playerUids.hasAny([request.auth.uid]));
        allow create: if signedIn()
          && request.auth.uid == playerUid
          && parentRoom().status == 'waiting'
          && getAfter(roomPath(roomCode)).data.playerUids.hasAny([request.auth.uid])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 18
          && request.resource.data.animal is map
          && request.resource.data.seat is int
          && request.resource.data.seat == parentRoom().playerUids.size()
          && request.resource.data.seat >= 0
          && request.resource.data.seat < parentRoom().maxPlayers;
        allow update, delete: if isRoomAdmin();
      }

      match /rollRequests/{playerUid} {
        function parentRoom() {
          return get(roomPath(roomCode)).data;
        }
        function isRoomAdmin() {
          return signedIn() && parentRoom().adminUid == request.auth.uid;
        }
        function isCurrentPlayer() {
          let room = parentRoom();
          return signedIn()
            && room.status == 'playing'
            && room.gameState != null
            && room.gameState.players[room.gameState.currentPlayer].uid == request.auth.uid
            && room.gameState.turnPhase == 'roll';
        }

        allow get: if signedIn() && (request.auth.uid == playerUid || isRoomAdmin());
        allow list: if isRoomAdmin();
        allow create: if request.auth.uid == playerUid
          && isCurrentPlayer()
          && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type == 'roll'
          && request.resource.data.createdAt is int;
        allow update: if false;
        allow delete: if isRoomAdmin();
      }

      match /playerActionRequests/{playerUid} {
        function parentRoom() {
          return get(roomPath(roomCode)).data;
        }
        function isRoomAdmin() {
          return signedIn() && parentRoom().adminUid == request.auth.uid;
        }
        function activeChallenge() {
          return parentRoom().gameState.activeChallenge;
        }
        function isActivePlayer() {
          let room = parentRoom();
          return signedIn()
            && room.status == 'playing'
            && room.gameState != null
            && room.gameState.turnPhase == 'challenge'
            && room.gameState.activeChallenge != null
            && room.gameState.activeChallenge.targetUid == request.auth.uid
            && room.gameState.players[room.gameState.currentPlayer].uid == request.auth.uid;
        }
        function isTradeRecipient() {
          let room = parentRoom();
          return signedIn()
            && room.status == 'playing'
            && room.gameState != null
            && room.gameState.turnPhase == 'challenge'
            && room.gameState.activeChallenge != null
            && room.gameState.activeChallenge.tradeOffer != null
            && room.gameState.activeChallenge.tradeOffer.targetUid == request.auth.uid;
        }

        allow get: if signedIn() && (request.auth.uid == playerUid || isRoomAdmin());
        allow list: if isRoomAdmin();
        allow create: if request.auth.uid == playerUid
          && request.resource.data.keys().hasOnly([
            'uid', 'challengeId', 'action', 'createdAt',
            'ownerIndex', 'spaceIndex', 'targetUid', 'ownSpaceIndex', 'targetSpaceIndex'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.challengeId is string
          && request.resource.data.challengeId == activeChallenge().id
          && request.resource.data.action is string
          && request.resource.data.createdAt is int
          && (
            (isActivePlayer()
              && request.resource.data.action == 'pay'
              && activeChallenge().kind == 'rentChallenge'
              && activeChallenge().answered == false)
            || (isActivePlayer()
              && activeChallenge().answered == true
              && request.resource.data.action in ['buy', 'continue', 'discount', 'tradeOffer', 'moveCard', 'jailCard'])
            || (isTradeRecipient()
              && request.resource.data.action in ['acceptTrade', 'declineTrade'])
          )
          && (
            (request.resource.data.action == 'discount'
              && request.resource.data.ownerIndex is int
              && request.resource.data.spaceIndex is int)
            || (request.resource.data.action == 'tradeOffer'
              && request.resource.data.targetUid is string
              && request.resource.data.ownSpaceIndex is int
              && request.resource.data.targetSpaceIndex is int)
            || (request.resource.data.action in ['pay', 'buy', 'continue', 'acceptTrade', 'declineTrade', 'moveCard', 'jailCard'])
          );
        allow update: if false;
        allow delete: if isRoomAdmin();
      }

      match /answerRequests/{playerUid} {
        function parentRoom() {
          return get(roomPath(roomCode)).data;
        }
        function isRoomAdmin() {
          return signedIn() && parentRoom().adminUid == request.auth.uid;
        }
        function isTargetedActivePlayer() {
          let room = parentRoom();
          return signedIn()
            && room.status == 'playing'
            && room.gameState != null
            && room.gameState.turnPhase == 'challenge'
            && room.gameState.activeChallenge != null
            && room.gameState.activeChallenge.targetUid == request.auth.uid
            && room.gameState.players[room.gameState.currentPlayer].uid == request.auth.uid;
        }

        allow get: if signedIn() && (request.auth.uid == playerUid || isRoomAdmin());
        allow list: if isRoomAdmin();
        allow create: if request.auth.uid == playerUid
          && isTargetedActivePlayer()
          && request.resource.data.keys().hasOnly(['uid', 'challengeId', 'answer', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.challengeId is string
          && request.resource.data.challengeId == parentRoom().gameState.activeChallenge.id
          && request.resource.data.answer is string
          && request.resource.data.answer.size() >= 1
          && request.resource.data.answer.size() <= 100
          && request.resource.data.createdAt is int;
        allow update: if false;
        allow delete: if isRoomAdmin();
      }
    }

    match /players/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
